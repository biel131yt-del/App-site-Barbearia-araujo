// Schema Prisma — Produção na Vercel (PostgreSQL/Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Servico {
  id          String   @id @default(cuid())
  nome        String
  precoCentavos Int
  duracaoMin  Int      @default(40)
  descricao   String   @default("")
  fotoUrl     String?
  faixa       String   @default("adulto")
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
  agendamentos   Agendamento[]
  listaEspera    ListaEspera[]
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String   @unique
  bonusResetEm DateTime?
  criadoEm  DateTime @default(now())
  agendamentos Agendamento[]
}

model Disponibilidade {
  id      String @id @default(cuid())
  dataISO String
  inicio  String
  fim     String
  slotMin Int    @default(60)
  criadoEm DateTime @default(now())
  @@unique([dataISO, inicio])
  @@index([dataISO])
}

model Agendamento {
  id        String @id @default(cuid())
  dataISO   String
  hora      String
  pagamento String @default("local")
  status    String @default("confirmado")
  pagamentoId String?
  qrTexto     String?
  trocoPara String?
  pushStatus     String @default("pendente")
  googleStatus   String @default("pendente")
  emailStatus    String @default("pendente")
  confirmadoWhatsApp Boolean @default(false)
  tokenAcesso String? @unique
  motivoCancelamento String?
  canceladoEm        DateTime?
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  avaliacao Avaliacao?
  criadoEm DateTime @default(now())
  @@unique([dataISO, hora])
  @@index([dataISO])
  @@index([clienteId])
}

model Avaliacao {
  id           String   @id @default(cuid())
  agendamentoId String  @unique
  nota         Int
  comentario   String?
  criadoEm     DateTime @default(now())
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
}

model ListaEspera {
  id        String   @id @default(cuid())
  servicoId String
  dataISO   String
  nome      String
  telefone  String
  horaPreferida String?
  notificado Boolean @default(false)
  atendido  Boolean @default(false)
  criadoEm  DateTime @default(now())
  servico Servico @relation(fields: [servicoId], references: [id])
  @@index([dataISO])
  @@index([atendido])
}

model GoogleConta {
  id           String   @id @default("principal")
  refreshToken String
  email        String?
  atualizadoEm DateTime @updatedAt
}

model PushInscricao {
  endpoint String   @id
  p256dh   String
  auth     String
  criadoEm DateTime @default(now())
}

model Usuario {
  id        String    @id @default(cuid())
  nome      String
  login     String    @unique
  senhaHash String
  papel     String    @default("super_admin")
  ativo     Boolean   @default(true)
  expiraEm  DateTime?
  criadoEm  DateTime  @default(now())
}

model CaixaFechamento {
  dataISO       String   @id
  totalCentavos Int
  totalPix      Int
  totalDinheiro Int
  qtd           Int
  fechadoEm     DateTime @default(now())
}

model Configuracao {
  id               String  @id @default("global")
  fidelidadeAtiva  Boolean @default(true)
  cortesParaGratis Int     @default(10)
  instagramUrl     String  @default("")
  mensagemWhats    String  @default("")
}
