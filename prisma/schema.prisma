// Schema Prisma — FASE 3 (PostgreSQL p/ produção na Vercel)
// Migra p/ Postgres/Supabase depois trocando provider + DATABASE_URL.
// Comente em português para manutenção do dono.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Serviço oferecido (Corte, Barba, Combo...)
model Servico {
  id          String   @id @default(cuid())
  nome        String
  // preço em centavos (ex: 3500 = R$ 35,00) — evita erro de float
  precoCentavos Int
  duracaoMin  Int      @default(40)
  descricao   String   @default("")
  fotoUrl     String? // FASE extra: foto real do corte (opcional)
  faixa       String   @default("adulto") // adulto | infantil (filtro na hora de marcar)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  agendamentos   Agendamento[]
  listaEspera    ListaEspera[]
}

// Cliente identificado pelo WhatsApp/telefone (único)
model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String   @unique // só dígitos, ex: 555196824286
  bonusResetEm DateTime? // FASE extra: fidelidade conta só após este marco
  criadoEm  DateTime @default(now())

  agendamentos Agendamento[]
}

// Dia que o dono ABRIU manualmente (ex: 26/10 19:00–22:00)
// slotMin: tamanho de cada horário (30 ou 60 min). Sem registro = fechado.
model Disponibilidade {
  id      String @id @default(cuid())
  dataISO String // yyyy-mm-dd
  inicio  String // HH:mm (ex: 19:00)
  fim     String // HH:mm (ex: 22:00)
  slotMin Int    @default(60)

  criadoEm DateTime @default(now())

  @@unique([dataISO, inicio])
  @@index([dataISO])
}

// Agendamento do cliente
model Agendamento {
  id        String @id @default(cuid())
  dataISO   String // yyyy-mm-dd
  hora      String // HH:mm
  pagamento String @default("local") // pix | local
  status    String @default("confirmado") // confirmado | aguardando | pago | pendente | cancelado | concluido

  // PIX via Mercado Pago (FASE 7) — null quando "pagar no local"
  pagamentoId String? // id do pagamento no Mercado Pago
  qrTexto     String? // código copia-e-cola

  // Troco (dinheiro): "para quanto" o cliente vai pagar (ex: "100"). Null = sem troco/PIX.
  trocoPara String?

  // Status de cada notificação (FASE extra) — visível no painel do dono
  pushStatus     String @default("pendente") // enviado | sem-inscricao | falha
  googleStatus   String @default("pendente") // criado | desligado | falha
  emailStatus    String @default("pendente") // enviado | desligado | falha

  // Confirmação via WhatsApp (obrigatória para o barbeiro)
  confirmadoWhatsApp Boolean @default(false) // cliente já enviou a confirmação no WhatsApp?

  // Cancelamento pelo cliente
  motivoCancelamento String? // por que desistiu
  canceladoEm        DateTime? // quando cancelou

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  avaliacao Avaliacao?

  criadoEm DateTime @default(now())

  // impede 2 agendamentos no mesmo dia+hora
  @@unique([dataISO, hora])
  @@index([dataISO])
  @@index([clienteId])
}

// Avaliação do cliente após o corte (FASE nova)
model Avaliacao {
  id           String   @id @default(cuid())
  agendamentoId String  @unique // uma avaliação por agendamento
  nota         Int      // 1 a 5 estrelas
  comentario   String?  // depoimento livre
  criadoEm     DateTime @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
}

// Lista de espera — cliente quer um horário lotado (FASE nova)
model ListaEspera {
  id        String   @id @default(cuid())
  servicoId String   // qual serviço deseja
  dataISO   String   // yyyy-mm-dd — dia que quer
  nome      String
  telefone  String   // só dígitos, ex: 555196824286
  horaPreferida String? // HH:mm — horário que preferia (opcional)
  notificado Boolean @default(false) // já avisamos que abriu vaga?
  atendido  Boolean @default(false) // conseguiu agendar?
  criadoEm  DateTime @default(now())

  servico Servico @relation(fields: [servicoId], references: [id])
  @@index([dataISO])
  @@index([atendido])
}

// Conta Google do dono (OAuth2) — FASE 5
// Guarda o refresh_token para criar eventos sem pedir login de novo.
// TODO produção: criptografar refreshToken antes de salvar.
model GoogleConta {
  id           String   @id @default("principal")
  refreshToken String
  email        String?
  atualizadoEm DateTime @updatedAt
}

// Inscrição push do aparelho do dono (Web Push) — FASE 6
// Um registro por aparelho/navegador (endpoint é único).
model PushInscricao {
  endpoint String   @id
  p256dh   String
  auth     String
  criadoEm DateTime @default(now())
}

// Usuário do painel (dono + equipe) — FASE 9
// papel: super_admin (tudo) | admin (geral) | barbeiro (agenda+clientes)
// expiraEm: acesso temporário (ex: amigo testando) — null = permanente
model Usuario {
  id        String    @id @default(cuid())
  nome      String
  login     String    @unique // ex: dono
  senhaHash String
  papel     String    @default("admin")
  ativo     Boolean   @default(true)
  expiraEm  DateTime?
  criadoEm  DateTime  @default(now())
}

// Fechamento de caixa do dia — FASE 9 (foto do dia p/ relatório mensal)
model CaixaFechamento {
  dataISO       String   @id // yyyy-mm-dd
  totalCentavos Int
  totalPix      Int
  totalDinheiro Int
  qtd           Int
  fechadoEm     DateTime @default(now())
}

// Config global do negócio — FASE extra (fidelidade, instagram)
// id sempre "global". GET público (site precisa ler), PATCH só super_admin.
model Configuracao {
  id               String  @id @default("global")
  fidelidadeAtiva  Boolean @default(true)
  cortesParaGratis Int     @default(10)
  instagramUrl     String  @default("")
  mensagemWhats    String  @default("") // modelo da msg p/ cliente (vazio = padrão)
}
