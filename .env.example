# Copie para .env (dev local) e preencha. Nunca commitar segredos reais.
# WhatsApp do dono (NORMAL/pessoal, só dígitos com DDI)
NEXT_PUBLIC_WHATSAPP_DONO=555196824286

# FASE 3 — Banco SQLite local (grátis, nunca desativa)
DATABASE_URL="file:./dev.db"

# FASE 5 — Google Calendar (OAuth2). Redirect: /api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# FASE 6 — Push PWA (gerar com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
# FASE 6 — E-mail backup (vazio = desligado)
RESEND_API_KEY=""
EMAIL_DONO=""

# FASE 7 — PIX via Mercado Pago (vazio = PIX indisponível, cai p/ "no local")
MERCADOPAGO_ACCESS_TOKEN=""

# FASE 9 — Auth do painel (gerar string longa em produção)
NEXTAUTH_SECRET="troque-por-uma-string-longa-e-aleatoria"
NEXTAUTH_URL="http://localhost:3000"
